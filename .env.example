# SERVER & DATABASE CONFIGURATION
PORT=3000
# MONGODB_URI: Connection string for real MongoDB instance (e.g. mongodb://localhost:27017/foodpool or MongoDB Atlas).
# If omitted or offline, FOODPOOL seamlessly persists data to local document storage at server/data/foodpool_db.json.
MONGODB_URI="mongodb://localhost:27017/foodpool"
JWT_SECRET="foodpool_production_jwt_secret_key_2026"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

